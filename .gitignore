# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/
# Worker MapLibre 6 — `apps/web/next.config.mjs` sao tu node_modules moi lan Next nap cau hinh (#374).
apps/web/public/maplibre/

# Environment & secrets
.env
.env.*
!.env.example
# Phien dang nhap zca-js (cookie/imei/userAgent) + ma QR — la session token, KHONG commit
secrets/
# Ho so khao sat khach hang — PII THAT (dia chi, SDT, PO, STK, bang gia) — KHONG commit len GitHub.
# Dung cuc bo de nap nguon su that; da trich vao apps/api/src/knowledge/seed.ts.
docs/khach-hang/*/nguon-goc/ho-so-khao-sat/
# TAI LIEU GOC CUA KHACH — moi dinh dang nhi phan trong vung `nguon-goc/`.
#
# Dong tren chi chan mot THU MUC CON, va do la du de mot ho so khao sat that (co ten nguoi lien he
# va so dien thoai) nam ngay canh no trong suot mot thoi gian — repo nay PUBLIC. Byte goc cua khach
# thuoc ve kho rieng; repo giu SHA-256 va metadata. Xem:
#   docs/phat-trien/van-hanh/nguon-khach-hang.md
#   tools/customer-source-guardrail/  (cong thi hanh o CI)
docs/khach-hang/*/nguon-goc/**/*.docx
docs/khach-hang/*/nguon-goc/**/*.doc
docs/khach-hang/*/nguon-goc/**/*.pdf
docs/khach-hang/*/nguon-goc/**/*.xlsx
docs/khach-hang/*/nguon-goc/**/*.xls
# Vung lam viec rieng trong repo — chi duoc ton tai neu duoc gitignore (uu tien de NGOAI repo).
.customer-sources/

# BAN BUILD cua mau A4 gui khach — sinh tu tools/excel-template/generate_a4_template.py.
#
# Ban truoc duoc COMMIT, va do la mot ro ri that: no chua ba ten dai ly va HAI CHAT ID NHOM ZALO
# lay tu khao sat (chinh sheet huong dan cua no ghi "du lieu that tu khao sat"), trong mot repo
# PUBLIC. Ghim SHA-256 chi chung minh "van la dung tep do" — no khong chung minh tep do an toan.
# Mot ro ri on dinh van la mot ro ri.
#
# Gio: generator sinh du lieu VI DU tong hop, ban build khong vao git, va bai test cua importer
# dung fixture rieng tai apps/api/src/settings/__fixtures__/.
docs/khach-hang/*/trao-doi/*.xlsx
docs/khach-hang/*/trao-doi/*.xls
docs/khach-hang/*/trao-doi/*.docx
docs/khach-hang/*/trao-doi/*.doc

# Logs
*.log
logs/

# Database
*.sqlite
*.db
apps/api/data/

# OS / editor / vendor agent tools
.DS_Store
Thumbs.db
.idea/
.vscode/
.agents/
/agents/

# Claude Code — cai gi THEO REPO thi commit, cai gi theo MAY thi khong.
#   .claude/settings.json       -> COMMIT (cau hinh chung cua repo)
#   .claude/settings.local.json -> KHONG commit (rieng tung may, co the chua duong dan/bi mat)
#   .claude/worktrees/          -> KHONG commit (cay lam viec native cua `claude --worktree`)
# Hai dong duoi truoc day chi duoc che boi gitignore TOAN MAY (~/.config/git/ignore) va boi
# .git/info/exclude CUC BO — khong thu nao di theo repo sang mot clone hay mot may khac.
.claude/settings.local.json
.claude/worktrees/

# Temp
*.tmp
.cache/
.runtime/

# Test & build artifacts
coverage/
*.tsbuildinfo
.swc/
# AdminJS bundler output (tao khi chay panel /admin — artifact, khong commit)
.adminjs/
# Playwright E2E output (trace/screenshot cua lan chay gan nhat)
test-results/
# Anh chup lam bang chung cua bo E2E — sinh ra o moi lan chay, khong phai nguon.
e2e-evidence/
playwright-report/
# Anh chup deterministic cua man bang gia (#144) — sinh lai tu bo test, khong commit
apps/web/e2e/__focus__/

# File khoa tam cua Microsoft Word (sinh ra khi mo .docx trong docs/khach-hang/)
~$*

# Thu muc nhap cuc bo. Da tung chua anh chup BANG GIA cua khach (tmp/pdfs/) va suyt bi commit bang
# mot `git add -A` — dung de no co co hoi lan sau. .dockerignore da loai `tmp` tu truoc.
tmp/

# Bao cao tin hieu deploy — sinh ra o goc checkout luc chay CD (deploy-ci.sh), khong commit.
deploy-signals.json
deploy-signals.log
